{
  "configs": [
    {
      "title": "Salt Extend Online · 设置",
      "config": "config.json",
      "preferences": [
        {
          "type": "button",
          "title": "侧栏管理",
          "summary": "入口显隐、侧栏优化、隐藏侧栏和切换按钮。",
          "arrow_type": "arrow",
          "on_click": "io.github.yghfv.saltneri.plugin.ExperimentalPlugin.openSidebarSettings"
        },
        {
          "type": "button",
          "title": "自动换源",
          "summary": "网易云、QQ 音乐、酷狗音乐和 Apple Music 的备用音源设置。",
          "arrow_type": "arrow",
          "on_click": "io.github.yghfv.saltneri.plugin.ExperimentalPlugin.openAutoSourceSettings"
        },
        {
          "type": "button",
          "title": "音质",
          "summary": "设置各平台的播放音质。",
          "arrow_type": "arrow",
          "on_click": "io.github.yghfv.saltneri.plugin.ExperimentalPlugin.openQualitySettings"
        },
        {
          "type": "button",
          "title": "代理设置",
          "summary": "各源默认直连，可分别选择使用系统代理。",
          "arrow_type": "arrow",
          "on_click": "io.github.yghfv.saltneri.plugin.ExperimentalPlugin.openProxySettings"
        },
        {
          "type": "button",
          "title": "默认栏目",
          "summary": "设置 Salt 启动首页和各平台默认栏目。",
          "arrow_type": "arrow",
          "on_click": "io.github.yghfv.saltneri.plugin.ExperimentalPlugin.openHomeSettings"
        },
        {
          "key": "cover.mode",
          "type": "list",
          "title": "封面裁切",
          "summary": "默认保持原比例。列表即时生效；播放封面在下次打开曲目时生效，不改源图片。",
          "entries": [
            "保持比例（默认）",
            "居中裁切",
            "靠左裁切",
            "靠右裁切"
          ],
          "entry_values": [
            "fit",
            "center",
            "left",
            "right"
          ],
          "default_value": "fit"
        },
        {
          "key": "catalog.pageLimit",
          "type": "list",
          "title": "单页上限",
          "summary": "Bilibili、网易云与 QQ 音乐共用，默认 30。无上限先显示前 30 项，向下滚动时继续加载；搜索、排序和全部播放仍覆盖完整合集。修改后当前列表回到开头，保留搜索与排序。",
          "entries": [
            "20",
            "30（默认）",
            "50",
            "60",
            "100",
            "无上限"
          ],
          "entry_values": [
            "20",
            "30",
            "50",
            "60",
            "100",
            "0"
          ],
          "default_value": "30"
        },
        {
          "key": "cache.limitMiB",
          "type": "list",
          "title": "音频缓存上限",
          "summary": "默认 2 GB，按实际读取的音频分段缓存；超限淘汰最久未用分段，不影响队列。仅限本插件缓存，不修改 Salt 自身的临时播放缓冲。",
          "entries": [
            "不缓存",
            "512 MB",
            "1 GB",
            "2 GB（默认）",
            "4 GB",
            "8 GB"
          ],
          "entry_values": [
            "0",
            "512",
            "1024",
            "2048",
            "4096",
            "8192"
          ],
          "default_value": "2048"
        },
        {
          "type": "button",
          "title": "清理音频缓存",
          "summary": "只清除本插件缓存，后续按需重新获取；不删除账号、队列或本地音乐。",
          "arrow_type": "none",
          "on_click": "io.github.yghfv.saltneri.plugin.ExperimentalPlugin.clearCache"
        },
        {
          "type": "button",
          "title": "查看诊断信息",
          "summary": "查看模组接入、登录阶段和播放适配状态；不显示凭据或音频地址。",
          "arrow_type": "none",
          "on_click": "io.github.yghfv.saltneri.plugin.ExperimentalPlugin.showStatus"
        }
      ]
    }
  ]
}
