          "entry_values": [
            "standard",
            "higher",
            "exhigh",
            "lossless",
            "hires",
            "jyeffect",
            "sky",
            "jymaster"
          ],
          "default_value": "standard"
        },
        {
          "key": "netease.autoSourceSwitch",
          "type": "switch",
          "title": "网易云自动换源",
          "summary": "网易云无法提供完整音轨时，按歌名、歌手及时长匹配 Bilibili 音源。需要已登录 B 站，保留原歌曲身份与歌词；不绕过会员、试听或风控。下一次打开曲目生效。",
          "default_value": false
        },
        {
          "key": "qqmusic.home",
          "type": "list",
          "title": "QQ 音乐 默认首页",
          "summary": "首次进入平台时打开的栏目。",
          "entries": [
            "发现",
            "收藏",
            "订阅"
          ],
          "entry_values": [
            "DISCOVER",
            "MINE",
            "SAVED"
          ],
          "default_value": "DISCOVER"
        },
        {
          "key": "qqmusic.quality",
          "type": "list",
          "title": "QQ 音乐音质",
          "summary": "参考 NeriPlayer，按当前账号授权降级；只播放完整音轨，不播放试听。下次打开曲目生效。",
          "entries": [
            "标准",
            "较高",
            "极高",
            "无损",
            "Hi-Res",
            "臻品全景声 5.1",
            "臻品全景声 7.1",
            "杜比",
            "DTS:X",
            "臻品母带"
          ],
          "entry_values": [
            "standard",
            "higher",
            "exhigh",
            "lossless",
            "hires",
            "atmos51",
            "atmos71",
            "dolby",
            "dtsx",
            "master"
          ],
          "default_value": "standard"
        },
        {
          "key": "qqmusic.autoSourceSwitch",
          "type": "switch",
          "title": "QQ 音乐自动换源",
          "summary": "仅完整音轨不可用时按歌名、歌手、时长匹配 Bilibili。需要已登录 B 站，保留 QQ 歌曲身份与歌词；不对登录、网络或风控失败换源。默认关闭。",
          "default_value": false
        },
        {
          "key": "cover.mode",
          "type": "list",
          "title": "封面裁切",
          "summary": "默认保持原比例。列表即时生效；播放封面在下次打开曲目时生效，不改源图片。",
          "entries": [
            "保持比例（默认）",
            "居中裁切",
            "靠左裁切",
            "靠右裁切"
          ],
          "entry_values": [
            "fit",
            "center",
            "left",
            "right"
          ],
          "default_value": "fit"
        },
        {
          "key": "catalog.pageLimit",
          "type": "list",
          "title": "单页上限",
          "summary": "Bilibili、网易云与 QQ 音乐共用，默认 30。无上限先显示前 30 项，向下滚动时继续加载；搜索、排序和全部播放仍覆盖完整合集。修改后当前列表回到开头，保留搜索与排序。",
          "entries": [
            "20",
            "30（默认）",
            "50",
            "60",
            "100",
            "无上限"
          ],
          "entry_values": [
            "20",
            "30",
            "50",
            "60",
            "100",
            "0"
          ],
          "default_value": "30"
        },
        {
          "key": "cache.limitMiB",
          "type": "list",
          "title": "音频缓存上限",
          "summary": "默认 2 GB，按实际读取的音频分段缓存；超限淘汰最久未用分段，不影响队列。仅限本插件缓存，不修改 Salt 自身的临时播放缓冲。",
          "entries": [
            "不缓存",
            "512 MB",
            "1 GB",
            "2 GB（默认）",
            "4 GB",
            "8 GB"
          ],
          "entry_values": [
            "0",
            "512",
            "1024",
            "2048",
            "4096",
            "8192"
          ],
          "default_value": "2048"
        },
        {
          "type": "button",
          "title": "清理音频缓存",
          "summary": "只清除本插件缓存，后续按需重新获取；不删除账号、队列或本地音乐。",
          "arrow_type": "none",
          "on_click": "io.github.yghfv.saltneri.plugin.ExperimentalPlugin.clearCache"
        },
        {
          "type": "button",
          "title": "修复侧栏入口",
          "summary": "仅当 Bilibili / 网易云 / QQ 音乐入口未出现时使用。",
          "arrow_type": "none",
          "on_click": "io.github.yghfv.saltneri.plugin.ExperimentalPlugin.installNativeUi"
        },
        {
          "type": "button",
          "title": "查看诊断信息",
          "summary": "查看模组接入、登录阶段和播放适配状态；不显示凭据或音频地址。",
          "arrow_type": "none",
          "on_click": "io.github.yghfv.saltneri.plugin.ExperimentalPlugin.showStatus"
        }
      ]
    }
  ]
}
