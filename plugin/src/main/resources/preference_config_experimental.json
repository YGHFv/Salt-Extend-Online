{
  "configs": [
    {
      "title": "Salt Extend Online · 设置",
      "config": "config.json",
      "preferences": [
        {
          "type": "button",
          "title": "打开在线音乐",
          "summary": "从侧栏进入 Bilibili / 网易云；登录、搜索与账号管理都在平台页面。",
          "arrow_type": "none",
          "on_click": "io.github.yghfv.saltneri.plugin.ExperimentalPlugin.openLibrary"
        },
        {
          "key": "auth.remember",
          "type": "switch",
          "title": "记住登录",
          "summary": "加密保存并在启动时恢复本插件账号；关闭后删除保存，不退出当前账号。",
          "default_value": true
        },
        {
          "key": "ui.sidebarOptimization",
          "type": "switch",
          "title": "侧栏优化",
          "summary": "收起侧栏时，将导航图标移至顶部侧栏切换按钮右侧；再次展开自动还原。包括在线平台和本地歌单，窄窗口可横向滚动。默认关闭。",
          "default_value": false
        },
        {
          "key": "bili.quality",
          "type": "list",
          "title": "Bilibili 音质",
          "summary": "优先所选音质，不可用时降至当前账号合法可用音轨；下一次打开曲目生效。",
          "entries": [
            "杜比",
            "Hi-Res",
            "无损",
            "高音质",
            "中音质",
            "低音质"
          ],
          "entry_values": [
            "dolby",
            "hires",
            "lossless",
            "high",
            "medium",
            "low"
          ],
          "default_value": "high"
        },
        {
          "key": "netease.quality",
          "type": "list",
          "title": "网易云音质",
          "summary": "参考 NeriPlayer；会员档位需要相应权限，可接受服务端返回的较低音质，不播放试听。下一次打开曲目生效。",
          "entries": [
            "标准",
            "较高",
            "极高",
            "无损",
            "Hi-Res",
            "高清环绕声",
            "沉浸环绕声",
            "超清母带"
          ],
          "entry_values": [
            "standard",
            "higher",
            "exhigh",
            "lossless",
            "hires",
            "jyeffect",
            "sky",
            "jymaster"
          ],
          "default_value": "standard"
        },
        {
          "key": "cover.mode",
          "type": "list",
          "title": "封面裁切",
          "summary": "默认保持原比例。列表即时生效；播放封面在下次打开曲目时生效，不改源图片。",
          "entries": [
            "保持比例（默认）",
            "居中裁切",
            "靠左裁切",
            "靠右裁切"
          ],
          "entry_values": [
            "fit",
            "center",
            "left",
            "right"
          ],
          "default_value": "fit"
        },
        {
          "key": "catalog.pageLimit",
          "type": "list",
          "title": "单页上限",
          "summary": "Bilibili 与网易云共用，默认 30。无上限先显示前 30 项，向下滚动时继续加载；搜索、排序和全部播放仍覆盖完整合集。修改后当前列表回到开头，保留搜索与排序。",
          "entries": ["20", "30（默认）", "50", "60", "100", "无上限"],
          "entry_values": ["20", "30", "50", "60", "100", "0"],
          "default_value": "30"
        },
        {
          "key": "cache.limitMiB",
          "type": "list",
          "title": "音频缓存上限",
          "summary": "默认 2 GB，按实际读取的音频分段缓存；超限淘汰最久未用分段，不影响队列。仅限本插件缓存，不修改 Salt 自身的临时播放缓冲。",
          "entries": [
            "不缓存",
            "512 MB",
            "1 GB",
            "2 GB（默认）",
            "4 GB",
            "8 GB"
          ],
          "entry_values": [
            "0",
            "512",
            "1024",
            "2048",
            "4096",
            "8192"
          ],
          "default_value": "2048"
        },
        {
          "type": "button",
          "title": "清理音频缓存",
          "summary": "只清除本插件缓存，后续按需重新获取；不删除账号、队列或本地音乐。",
          "arrow_type": "none",
          "on_click": "io.github.yghfv.saltneri.plugin.ExperimentalPlugin.clearCache"
        },
        {
          "type": "button",
          "title": "修复侧栏入口",
          "summary": "仅当 Bilibili / 网易云入口未出现时使用。",
          "arrow_type": "none",
          "on_click": "io.github.yghfv.saltneri.plugin.ExperimentalPlugin.installNativeUi"
        },
        {
          "type": "button",
          "title": "查看诊断信息",
          "summary": "查看模组接入、登录阶段和播放适配状态；不显示凭据或音频地址。",
          "arrow_type": "none",
          "on_click": "io.github.yghfv.saltneri.plugin.ExperimentalPlugin.showStatus"
        }
      ]
    }
  ]
}
