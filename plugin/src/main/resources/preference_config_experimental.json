{
  "configs": [
    {
      "title": "Salt Extend Online · 设置",
      "config": "config.json",
      "preferences": [
        {
          "key": "ui.sidebarOptimization",
          "type": "switch",
          "title": "侧栏优化",
          "summary": "收起侧栏时，将导航图标移至顶部侧栏切换按钮右侧；再次展开自动还原。包括在线平台和本地歌单，窄窗口可横向滚动。默认关闭。",
          "default_value": false
        },
        {
          "key": "ui.hiddenSidebar",
          "type": "switch",
          "title": "隐藏侧栏",
          "summary": "仅在侧栏优化开启时生效。启用后收起侧栏，鼠标移到侧边或切换按钮不再自动展开；只有点击切换按钮才展开。",
          "default_value": false
        },
        {
          "key": "ui.hideSidebarToggle",
          "type": "switch",
          "title": "隐藏切换侧边栏按钮",
          "summary": "隐藏窗口顶部的侧栏切换按钮，不改变侧栏状态；开启侧栏优化后快捷入口仍显示。可在模组设置中关闭以恢复。",
          "default_value": false
        },
        {
          "key": "ui.home",
          "type": "list",
          "title": "Salt 首页",
          "summary": "启动时打开的页面；本地歌单自动逐个列出。恢复上次保留歌曲、平台或歌单页面。",
          "entries": [
            "恢复上次",
            "歌曲",
            "Bilibili",
            "网易云",
            "QQ 音乐"
          ],
          "entry_values": [
            "restore",
            "Track",
            "BILIBILI",
            "NETEASE",
            "QQMUSIC"
          ],
          "default_value": "restore"
        },
        {
          "type": "button",
          "title": "侧栏管理",
          "summary": "设置入口固定保留，其他功能按钮在此配置显隐。",
          "arrow_type": "arrow",
          "on_click": "io.github.yghfv.saltneri.plugin.ExperimentalPlugin.openSidebarSettings"
        },
        {
          "key": "bili.home",
          "type": "list",
          "title": "Bilibili 默认首页",
          "summary": "首次进入平台时打开的栏目。",
          "entries": [
            "发现",
            "收藏",
            "订阅"
          ],
          "entry_values": [
            "DISCOVER",
            "MINE",
            "SAVED"
          ],
          "default_value": "DISCOVER"
        },
        {
          "key": "bili.quality",
          "type": "list",
          "title": "Bilibili 音质",
          "summary": "优先所选音质，不可用时降至当前账号合法可用音轨；下一次打开曲目生效。",
          "entries": [
            "杜比",
            "Hi-Res",
            "无损",
            "高音质",
            "中音质",
            "低音质"
          ],
          "entry_values": [
            "dolby",
            "hires",
            "lossless",
            "high",
            "medium",
            "low"
          ],
          "default_value": "high"
        },
        {
          "key": "netease.home",
          "type": "list",
          "title": "网易云 默认首页",
          "summary": "首次进入平台时打开的栏目。",
          "entries": [
            "发现",
            "收藏",
            "订阅"
          ],
          "entry_values": [
            "DISCOVER",
            "MINE",
            "SAVED"
          ],
          "default_value": "DISCOVER"
        },
        {
          "key": "netease.quality",
          "type": "list",
          "title": "网易云音质",
          "summary": "参考 NeriPlayer；会员档位需要相应权限，可接受服务端返回的较低音质，不播放试听。下一次打开曲目生效。",
          "entries": [
            "标准",
            "较高",
            "极高",
            "无损",
            "Hi-Res",
            "高清环绕声",
            "沉浸环绕声",
