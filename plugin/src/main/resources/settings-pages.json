{
  "sidebar": [
    {
      "key": "ui.sidebarOptimization",
      "type": "switch",
      "title": "侧栏优化",
      "summary": "收起侧栏时，将导航图标移至顶部侧栏切换按钮右侧；再次展开自动还原。包括在线平台和本地歌单，窄窗口可横向滚动。默认关闭。",
      "default_value": false
    },
    {
      "key": "ui.hiddenSidebar",
      "type": "switch",
      "title": "隐藏侧栏",
      "summary": "仅在侧栏优化开启时生效。启用后收起侧栏，鼠标移到侧边或切换按钮不再自动展开；只有点击切换按钮才展开。",
      "default_value": false
    },
    {
      "key": "ui.hideSidebarToggle",
      "type": "switch",
      "title": "隐藏切换侧边栏按钮",
      "summary": "隐藏窗口顶部的侧栏切换按钮，不改变侧栏状态；开启侧栏优化后快捷入口仍显示。可在模组设置中关闭以恢复。",
      "default_value": false
    },
    {
      "type": "button",
      "title": "修复侧栏入口",
      "summary": "平台入口未出现时重新安装侧栏接入。",
      "action": "repairSidebar"
    }
  ],
  "auto-source": [
    {
      "key": "netease.autoSourceSwitch",
      "type": "switch",
      "title": "网易云自动换源",
      "summary": "完整音轨不可用时匹配 Bilibili 备用音源；保留原歌曲信息与歌词，需要已登录 B 站。",
      "default_value": false
    },
    {
      "key": "qqmusic.autoSourceSwitch",
      "type": "switch",
      "title": "QQ 音乐自动换源",
      "summary": "完整音轨不可用时匹配 Bilibili 备用音源；保留原歌曲信息与歌词，需要已登录 B 站。",
      "default_value": false
    },
    {
      "key": "kugou.autoSourceSwitch",
      "type": "switch",
      "title": "酷狗音乐自动换源",
      "summary": "完整音轨不可用时匹配 Bilibili 备用音源；保留原歌曲信息与歌词，需要已登录 B 站。",
      "default_value": false
    },
    {
      "key": "applemusic.autoSourceSwitch",
      "type": "switch",
      "title": "Apple Music自动换源",
      "summary": "完整音轨不可用时匹配 Bilibili 备用音源；保留原歌曲信息与歌词，需要已登录 B 站。",
      "default_value": false
    }
  ],
